# Canonical site URL used in metadata, the sitemap and robots.txt.
# Optional: defaults to https://settl-lk.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Never prefix these with NEXT_PUBLIC_.
# From your Supabase project's connection settings / API keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_key
